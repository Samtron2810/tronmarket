# Base URL of the TronMarket API (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Paystack public key used by the checkout widget
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Google sign-in (optional; the button renders only when set)
VITE_GOOGLE_CLIENT_ID=

# Analytics (optional; Plausible-compatible script is injected only when set)
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_SRC=https://plausible.io/js/script.js
